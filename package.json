{
  "name": "@andrewpopov/db-kit",
  "version": "0.0.0",
  "description": "Fleet database toolkit: open SQLite or Postgres from a DATABASE_URL with fleet-standard settings and a redacted description.",
  "author": "Andrew Popov",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/andrewpopov/db-kit.git"
  },
  "bugs": {
    "url": "https://github.com/andrewpopov/db-kit/issues"
  },
  "homepage": "https://github.com/andrewpopov/db-kit#readme",
  "keywords": [
    "sqlite",
    "postgres",
    "database",
    "drizzle",
    "typescript"
  ],
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./drizzle": {
      "types": "./dist/drizzle.d.ts",
      "default": "./dist/drizzle.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": "^22.12 || ^24 || >=26"
  },
  "scripts": {
    "build": "rm -rf dist && tsc",
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify:pack": "node scripts/verify-pack.mjs",
    "verify:dist-fresh": "node scripts/verify-dist-fresh.mjs",
    "audit:runtime": "npm audit --omit=dev --audit-level=high",
    "audit:development": "npm audit --audit-level=high",
    "verify": "npm run typecheck && npm test && npm run build && npm run verify:dist-fresh && npm run verify:pack && npm run audit:runtime && npm run audit:development",
    "release:note": "release-kit note",
    "release:notes": "release-kit notes",
    "release:bump": "release-kit bump",
    "release:cut": "release-kit cut",
    "release:check": "release-kit check",
    "release:hygiene": "release-kit hygiene",
    "prepare": "git config core.hooksPath .githooks || true"
  },
  "dependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/pg": "^8.15.0",
    "better-sqlite3": "^13.0.0",
    "pg": "^8.23.1",
    "zod": "^4.0.0"
  },
  "peerDependencies": {
    "drizzle-orm": "^0.45.0"
  },
  "peerDependenciesMeta": {
    "drizzle-orm": {
      "optional": true
    }
  },
  "devDependencies": {
    "@andrewpopov/deploy-kit": "github:andrewpopov/deploy-kit#v0.25.0",
    "@andrewpopov/release-kit": "github:andrewpopov/release-kit#v0.3.1",
    "@types/node": "^22.0.0",
    "drizzle-orm": "^0.45.0",
    "embedded-postgres": "17.10.0-beta.17",
    "typescript": "^5.5.0",
    "vitest": "^4.1.10"
  }
}
